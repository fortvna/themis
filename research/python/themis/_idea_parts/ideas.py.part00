_CALL_IT_RE = re.compile(
    r"\b(?:call it|name this|call this|name it)\s+([a-z0-9][a-z0-9-]{0,46}[a-z0-9]|[a-z0-9]{2})\b",
    re.IGNORECASE,
)
_SLUG_RE = re.compile(r"^[a-z0-9](?:[a-z0-9]|-(?!-))*[a-z0-9]$|^[a-z0-9]{2}$")

RETURN_NEEDLES = (
    "what is the return",
