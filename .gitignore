# Repo-local Python env only. Never commit it. Never pip --user instead.
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.env
.themis/
**/auth.json
research/.cache/
research/runs/*
!research/runs/.gitkeep
# Frozen prove packages under ideas are tracked. Live asks still write to research/runs/.
!research/ideas/**/runs/**
research/jobs/*
!research/jobs/.gitkeep
*.csv
*.zip
.DS_Store
research/questions/*
!research/questions/.gitkeep
research/specs/*
!research/specs/.gitkeep
research/reports/*
!research/reports/.gitkeep
